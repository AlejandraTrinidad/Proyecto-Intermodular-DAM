<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:background="@drawable/bg_group_card"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <!-- IMAGEN DEL GRUPO (O candado si falta) -->
    <ImageView
        android:id="@+id/imgGroup"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:background="@drawable/bg_circle_image"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_lock" />

    <!-- NOMBRE DEL GRUPO O "Falta" -->
    <TextView
        android:id="@+id/txtGroupName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Aespa"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- CHECK DE COMPLETADO (O oculto si falta) -->
    <ImageView
        android:id="@+id/imgCheck"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="4dp"
        android:src="@drawable/ic_check_circle"
        app:tint="#a855f7" />

</LinearLayout>