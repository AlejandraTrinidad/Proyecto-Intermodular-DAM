<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".FragmentoGacha">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:id="@+id/viewHeaderBackground"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:background="#1A0F35"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- LOGO APLICACIÓN -->
        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="16dp"
            android:src="@drawable/icono_logo"
            app:layout_constraintBottom_toBottomOf="@+id/viewHeaderBackground"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/viewHeaderBackground" />

        <!--MENU PUNTOS + MONEDAS -->

        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="K-POP Hub"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/viewHeaderBackground"
            app:layout_constraintEnd_toStartOf="@+id/layoutPoints"
            app:layout_constraintHorizontal_bias="0.731"
            app:layout_constraintStart_toEndOf="@+id/ivLogo"
            app:layout_constraintTop_toTopOf="@+id/viewHeaderBackground"
            app:layout_constraintVertical_bias="0.575" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutPoints"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_capsule"
            app:layout_constraintBottom_toBottomOf="@+id/viewHeaderBackground"
            app:layout_constraintEnd_toStartOf="@+id/ivMenu"
            app:layout_constraintTop_toTopOf="@+id/viewHeaderBackground">

            <ImageView
                android:id="@+id/ivCoin"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="10dp"
                android:src="@drawable/icono_moneda"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvPoints"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="12dp"
                android:text="150 Pts"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                app:layout_constraintStart_toEndOf="@+id/ivCoin"
                app:layout_constraintTop_toTopOf="@+id/ivCoin"
                app:layout_constraintBottom_toBottomOf="@+id/ivCoin"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/ivMenu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="☰"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:includeFontPadding="false"
            tools:ignore="HardcodedText"
            app:layout_constraintBottom_toBottomOf="@+id/viewHeaderBackground"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/viewHeaderBackground" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>